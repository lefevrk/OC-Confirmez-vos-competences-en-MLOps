# MLflow connection
MLFLOW_TRACKING_URI=https://mlflow.example.com
MLFLOW_TRACKING_USERNAME=replace_with_mlflow_username
MLFLOW_TRACKING_PASSWORD=replace_with_mlflow_password

# PostgreSQL prediction-event storage — points at the compose Postgres
# service's published port; overridden to the in-network hostname for the
# containerized API in compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credit_scoring

# Registered serving model
MODEL_NAME=credit_scoring
MODEL_ALIAS=champion

# Logging
LOG_LEVEL=INFO

# API authentication — leave empty to disable (local development)
API_TOKEN=

# URL called by the mounted Gradio UI. Set this to the public HTTPS API URL
# behind a reverse proxy in production.
SCORING_API_URL=http://127.0.0.1:8000

# Drift analysis — read-only access to the private HF Storage Bucket holding
# the reference dataset (scripts/download_drift_reference.py only, never
# read by the API itself)
HF_BUCKET_ID=replace_with_bucket_id
HF_BUCKET_READ_TOKEN=replace_with_read_scoped_token

# Grafana (local stack — observability/grafana/, observability/prometheus/, observability/loki/)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_local_password

# Alloy — reused unchanged in prod/staging (see deploy/.env.example), pointed
# here at the local Prometheus/Loki containers instead of Grafana Cloud.
DEPLOY_ENVIRONMENT=local
COMPOSE_PROJECT_FILTER=oc-confirmez-vos-competences-en-mlops
APP_SERVICES_FILTER=api|postgres
ALLOY_METRICS_URL=http://prometheus:9090/api/v1/write
ALLOY_METRICS_USERNAME=
ALLOY_LOGS_URL=http://loki:3100/loki/api/v1/push
ALLOY_LOGS_USERNAME=
ALLOY_API_KEY=
