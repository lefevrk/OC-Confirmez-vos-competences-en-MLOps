# Template for the .env that lives next to compose.yml on the VPS, in each
# environment's deploy directory (/home/ubuntu/deploy/credit_scoring/release/
# and .../prod/). Never committed with real values — copy this file there
# once by hand, then fill it in. docker compose reads it both to interpolate
# ${IMAGE_TAG}/${HOST_PORT} in compose.yml and, via env_file, to configure
# the running container.

# Deployment topology — the values that differ between release and prod
IMAGE_TAG=release
HOST_PORT=8010
DEPLOY_ENVIRONMENT=release
COMPOSE_PROJECT_FILTER=release

# MLflow connection
MLFLOW_TRACKING_URI=https://mlflow.example.com
MLFLOW_TRACKING_USERNAME=replace_with_mlflow_username
MLFLOW_TRACKING_PASSWORD=replace_with_mlflow_password

# PostgreSQL prediction-event storage — the Supabase project for this environment
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Registered serving model
MODEL_NAME=credit_scoring
MODEL_ALIAS=champion

# Logging
LOG_LEVEL=INFO

# API authentication
API_TOKEN=replace_with_a_real_token

# Grafana Cloud — same Alloy config as local (see references/TUTO_GRAFANA_CLOUD.md
# for how to obtain these), one stack shared by release and prod, distinguished
# by DEPLOY_ENVIRONMENT above, not by separate credentials.
APP_SERVICES_FILTER=api
ALLOY_METRICS_URL=https://prometheus-<region>.grafana.net/api/prom/push
ALLOY_METRICS_USERNAME=replace_with_grafana_cloud_metrics_username
ALLOY_LOGS_URL=https://logs-<region>.grafana.net/loki/api/v1/push
ALLOY_LOGS_USERNAME=replace_with_grafana_cloud_logs_username
ALLOY_API_KEY=replace_with_grafana_cloud_api_token
